{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CAN discovery findings",
  "description": "Output of can_discovery.py. Read-only signal map for the mycarplay APK builder agent. Bit convention: byte index is 0-based; bit 0 = LSB of that byte. A decoder reads: value = (frame.data[byte] >> bit) & 1, compared against off_state/on_state.",
  "type": "object",
  "required": ["meta", "signals"],
  "properties": {
    "meta": {
      "type": "object",
      "required": ["channel", "interface", "rounds", "window"],
      "properties": {
        "channel": {"type": "string", "description": "SocketCAN interface, e.g. can0"},
        "interface": {"type": "string", "description": "python-can backend, e.g. socketcan"},
        "rounds": {"type": "integer", "description": "OFF/ON repeats per event"},
        "window": {"type": "number", "description": "capture seconds per state"},
        "note": {"type": "string"}
      }
    },
    "signals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["key", "name", "candidates"],
        "properties": {
          "key": {"type": "string", "description": "stable event id, e.g. door_driver"},
          "name": {"type": "string", "description": "human label"},
          "candidates": {
            "type": "array",
            "description": "possible signal locations, strongest (highest confidence) first",
            "items": {
              "type": "object",
              "required": ["type", "arbitration_id", "confidence"],
              "properties": {
                "type": {
                  "type": "string",
                  "enum": ["steady", "activity", "presence"],
                  "description": "steady = constant bit that differs OFF vs ON (door, brake); activity = bit toggles in one state (blinker flash); presence = whole CAN ID only appears in one state"
                },
                "arbitration_id": {"type": "integer", "description": "CAN ID (decimal)"},
                "id_hex": {"type": "string"},
                "byte": {"type": "integer", "description": "0-based byte index within data (steady/activity only)"},
                "bit": {"type": "integer", "description": "0=LSB within that byte (steady/activity only)"},
                "bit_mask": {"type": "string", "description": "hex mask for the bit, e.g. 0x10"},
                "off_state": {"type": "string", "enum": ["const0", "const1", "toggle"]},
                "on_state": {"type": "string", "enum": ["const0", "const1", "toggle"]},
                "location": {"type": "string", "description": "human-readable location string"},
                "meaning": {"type": "string", "description": "for presence candidates"},
                "confidence": {"type": "number", "description": "0..1, fraction of rounds that agreed. 1.0 = held in every repeat"}
              }
            }
          }
        }
      }
    }
  }
}
